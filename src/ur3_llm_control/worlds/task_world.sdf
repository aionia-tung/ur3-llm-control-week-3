<?xml version="1.0" ?>
<sdf version="1.7">
<world name="ur3_llm_task_world">
<physics name="default_physics" type="ode">
  <max_step_size>0.001</max_step_size>
  <real_time_factor>1</real_time_factor>
</physics>

<plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
<plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
<plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
<plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
  <render_engine>ogre2</render_engine>
</plugin>

<light type="directional" name="sun">
  <pose>0 0 4 0 0 0</pose>
  <diffuse>0.8 0.8 0.8 1</diffuse>
  <direction>-0.4 0.3 -1</direction>
</light>

<model name="overhead_camera">
  <static>true</static>
  <pose>0.44 0 1.25 0 1.5707963 0</pose>
  <link name="camera_link">
    <sensor name="overhead_cam" type="camera">
      <topic>/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.1</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>3.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
    </sensor>
  </link>
</model>

<model name="worktable">
  <static>true</static>
  <pose>0.40 0 0.43 0 0 0</pose>
  <link name="table_link">
    <collision name="collision">
      <geometry><box><size>0.75 0.85 0.08</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.75 0.85 0.08</size></box></geometry>
      <material>
        <ambient>0.35 0.22 0.12 1</ambient>
        <diffuse>0.55 0.32 0.16 1</diffuse>
      </material>
    </visual>
  </link>
</model>

